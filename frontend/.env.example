# Leave this EMPTY on Vercel. The Next.js /api/v1 routes are the API.
# Setting this to localhost or a placeholder URL breaks login after deploy.
# NEXT_PUBLIC_API_URL=

# MongoDB Atlas (also set this in Vercel → Settings → Environment Variables)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/buysellbd?retryWrites=true&w=majority

# Optional JWT secret (same value in Vercel env)
JWT_ACCESS_SECRET=your_ultra_secure_jwt_access_secret_key_minimum_32_characters
